# ===== NetOps 平台配置示例 =====
# 复制为 .env 后按需修改。所有变量均以 NETOPS_ 前缀。

# ---------- 基础 ----------
# 生产环境务必修改为强随机字符串（一旦设置不可更改，否则已加密的设备凭据无法解密）
NETOPS_SECRET_KEY=change-me-to-a-strong-random-string-at-least-32-chars
NETOPS_DEBUG=false
NETOPS_CORS_ORIGINS=["*"]

# ---------- 存储 ----------
# SQLite（默认，零依赖）
NETOPS_DATABASE_URL=sqlite:///./netops.db
# PostgreSQL 示例：
# NETOPS_DATABASE_URL=postgresql+psycopg://netops:pass@127.0.0.1:5432/netops
# MySQL 示例：
# NETOPS_DATABASE_URL=mysql+pymysql://netops:pass@127.0.0.1:3306/netops

NETOPS_BACKUP_DIR=./data/backups
NETOPS_REPORT_DIR=./data/reports
NETOPS_IMPORT_EXPORT_DIR=./data/imports

# ---------- 安全 ----------
NETOPS_ACCESS_TOKEN_EXPIRE_MINUTES=720
NETOPS_LOGIN_MAX_FAILURES=5
NETOPS_LOGIN_LOCK_MINUTES=15

# ---------- 采集调度 ----------
NETOPS_SCHEDULER_ENABLED=true
NETOPS_DEFAULT_POLL_INTERVAL=60
NETOPS_MAX_CONCURRENT_POLL=20
NETOPS_SNMP_TIMEOUT=3.0
NETOPS_SNMP_RETRIES=1
NETOPS_SSH_TIMEOUT=20
NETOPS_METRIC_RETENTION_DAYS=30
NETOPS_LOG_RETENTION_DAYS=60

# ---------- Syslog 接收 ----------
NETOPS_SYSLOG_ENABLED=true
NETOPS_SYSLOG_HOST=0.0.0.0
NETOPS_SYSLOG_UDP_PORT=5514
NETOPS_SYSLOG_TCP_PORT=5514

# ---------- NetFlow / IPFIX 接收 ----------
NETOPS_NETFLOW_ENABLED=true
# 2055=NetFlow v9  4739=IPFIX  9995=NetFlow v5
NETOPS_NETFLOW_UDP_PORTS=[2055,4739,9995]
NETOPS_NETFLOW_TCP_PORTS=[]
NETOPS_NETFLOW_RETENTION_DAYS=7

# ---------- gNMI Telemetry ----------
NETOPS_TELEMETRY_ENABLED=true
NETOPS_GNMI_LISTEN_PORT=57400
NETOPS_TELEMETRY_SAMPLE_INTERVAL_MS=10000

# ---------- 域控对接 (LDAP / Active Directory) ----------
NETOPS_LDAP_ENABLED=false
NETOPS_LDAP_SERVER=ldap://dc.corp.local
NETOPS_LDAP_PORT=389
NETOPS_LDAP_USE_SSL=false
NETOPS_LDAP_START_TLS=false
NETOPS_LDAP_BASE_DN=DC=corp,DC=local
# 绑定账号（建议使用只读服务账号）
NETOPS_LDAP_BIND_DN=CN=svc-netops,OU=Service,DC=corp,DC=local
NETOPS_LDAP_BIND_PASSWORD=
# 用户定位方式：二选一
# 方式 A：直接指定 DN 模板
NETOPS_LDAP_USER_DN_TEMPLATE=CN={username},OU=Users,DC=corp,DC=local
# 方式 B：按过滤器搜索（留空上面一项即可启用）
NETOPS_LDAP_USER_FILTER=(sAMAccountName={username})
NETOPS_LDAP_DOMAIN=CORP
NETOPS_LDAP_DEFAULT_ROLE=viewer
# AD 组 → 平台角色映射（JSON）
NETOPS_LDAP_GROUP_ROLE_MAP={"CN=NetOps-Admins,OU=Groups,DC=corp,DC=local":"admin","CN=NetOps-Ops,OU=Groups,DC=corp,DC=local":"operator"}

# ---------- 通知 ----------
NETOPS_WEBHOOK_TIMEOUT=8.0
